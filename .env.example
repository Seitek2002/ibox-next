# Базовый URL REST API (обязательно со слешем на конце).
# Прод:
NEXT_PUBLIC_API_BASE_URL=https://ibox.kg/api/
# Стейдж:
# NEXT_PUBLIC_API_BASE_URL=https://stark.adamtech.dev/api/

# Origin для WebSocket. Если не задан — берётся хост из NEXT_PUBLIC_API_BASE_URL
# с заменой http(s) на ws(s), т.е. для прода это wss://ibox.kg.
# NEXT_PUBLIC_WS_BASE_URL=wss://ibox.kg
